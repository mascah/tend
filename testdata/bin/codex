#!/usr/bin/env bash
# Codex stand-in for headless agents: codex exec, or exec resume <thread>,
# with its prompt on stdin, taking the turn turn.sh gives TEND_AGENT; its
# thread goes first on stdout and its last message to the -o file. Logged as
# the Claude stand-in logs.
set -euo pipefail
s=$HERDR_STATE
p=$(cat)
o= tid=
[ "$1 ${2:-}" != "exec resume" ] || tid=$3
while [ $# -gt 0 ]; do [ "$1" != -o ] || o=$2; shift; done
if [ -z "$tid" ]; then
	tid=t-$$-$RANDOM && printf 'agent start %s\n' "$TEND_AGENT" >>"$s/log"
fi
printf 'agent prompt %s %s\n' "$TEND_AGENT" "$p" >>"$s/log"
. "${0%/*}/turn.sh"
echo "{\"type\":\"thread.started\",\"thread_id\":\"$tid\"}"
turn "$TEND_AGENT" "$p"
echo "Reviewed." >"$o"
