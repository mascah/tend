#!/usr/bin/env bash
# GitHub stand-in. "auth token --user A" gives tok-A, and every write records the
# account whose token made it. One PR per head branch: pr-<branch> holds its body
# and pr-<branch>.by its author. Reviews go to reviews (a JSON array, read back
# through the caller's --jq; a review's author_association is what GitHub
# gives as author association), statuses to statuses as "<sha> <state> <account>".
# CREATE_LOST opens the PR and then fails, as when GitHub acted but tend never
# heard back. pr-<branch>.merged marks it merged; its head is origin's branch,
# and pr-<branch>.base, if there, the branch it merges into instead of main.
# A status's description goes to descriptions as "<sha> <description>". ci
# holds the checks every commit gets, "<name> <conclusion>" a line, pending
# for one not finished; none, no checks. A PUT of a pull request's merge
# squash-merges onto origin's main as the account, merged-by naming it and
# merge-requests each head asked for, and refuses as GitHub would when the
# head moved or lacks main; REQUIRE_APPROVAL refuses without an approving
# review, CI_LATE (a check's name) refuses once for that check, then reports
# it passed, BEFORE_MERGE is a script run once before the first merge, DURING_CHECKS
# one run once as check runs are first read, CHECKS_SLEEP seconds slept in
# each read of check runs, each read's start in seconds going to check-reads, and
# MERGE_HOLD holds every merge until the file it names exists. GH_FAIL fails
# the first call whose arguments match it, once, as a blip.
set -euo pipefail
s=$HERDR_STATE
printf 'gh %s\n' "$*" >>"$s/log"
by=${GH_TOKEN:-owner} by=${by#tok-}
if [ -n "${GH_FAIL:-}" ] && [ ! -e "$s/gh-failed" ] && [[ "$*" == *$GH_FAIL* ]]; then
	touch "$s/gh-failed"
	echo "gh: HTTP 502: Bad Gateway" >&2
	exit 1
fi
arg() { local flag=$1; shift; while [ $# -gt 1 ]; do [ "$1" != "$flag" ] || { echo "$2"; return; }; shift; done; }
case "$1 $2" in
"auth token") echo "tok-$(arg --user "$@")" ;;
"pr list")
	# Every PR, then narrowed as the caller asks: by head branch in any state, by
	# author while open, or every open one.
	for w in "$s"/pr-*.where; do
		[ -e "$w" ] || continue
		k=${w%.where}
		[ -e "$k.merged" ] && st=MERGED || st=OPEN
		rd=$(jq -r --arg h "$(git -C "$(sed -n 2p "$w")" rev-parse "$(sed -n 1p "$w")" 2>/dev/null)" 'if any(.[]?; .state == "CHANGES_REQUESTED" and .commit_id == $h) then "CHANGES_REQUESTED" else "" end' "$s/reviews" 2>/dev/null || true)
		jq -n --arg b "$(sed -n 1p "$w")" --arg by "$(cat "$k.by")" --arg st "$st" --arg t "$(cat "$k.title" 2>/dev/null)" --arg u "https://example.test/pr/${k##*/pr-}" --arg rd "$rd" \
			--arg oid "$(git -C "$(sed -n 2p "$w")" rev-parse "$(sed -n 1p "$w")" 2>/dev/null)" \
			'{headRefName: $b, headRefOid: $oid, author: $by, state: $st, title: $t, url: $u, number: 1, reviewDecision: $rd}'
	done | jq -s --arg h "$(arg --head "$@")" --arg a "$(arg --author "$@")" --arg st "$(arg --state "$@")" '
		if $h != "" then map(select(.headRefName == $h)) elif $a != "" then map(select(.author == $a and .state == "OPEN")) elif $st == "all" then . else map(select(.state == "OPEN")) end' |
		if q=$(arg --jq "$@") && [ -n "$q" ]; then jq -r "$q"; else cat; fi ;;
"repo view") case "$*" in *defaultBranchRef*) echo main ;; *viewerPermission*) echo "${PERMISSION:-WRITE}" ;; *) echo o/r ;; esac ;;
"issue list") jq '[.[] | select(.state == "OPEN" and (.labels | index("tend")))]' "$s/issues" | jq -r "$(arg --jq "$@")" ;;
"issue view") jq --argjson n "$3" '.[] | select(.number == $n) | {title, body, url, state, labels: (.labels | map({name: .}))}' "$s/issues" ;;
"issue comment")
	[ -f "$s/comments" ] || echo '[]' >"$s/comments"
	jq --argjson n "$3" --arg by "$by" --rawfile b /dev/stdin '. + [{issue: $n, body: $b, user: {login: $by}}]' "$s/comments" >"$s/c.new" && mv "$s/c.new" "$s/comments" ;;
"issue create") # a decision tend asks: issue-<n> holds its body, issue-<n>.title its title, issue-<n>.state "open" or "closed <reason> <login>"
	n=$(($(cat "$s/issues-made" 2>/dev/null || echo 99) + 1)) && echo "$n" >"$s/issues-made"
	cat >"$s/issue-$n" && arg --title "$@" >"$s/issue-$n.title" && echo "$by" >"$s/issue-$n.by" && echo open >"$s/issue-$n.state"
	echo "https://github.com/o/r/issues/$n" ;;
"issue close") echo "closed completed $by" >"$s/issue-${3##*/}.state" ;;
"issue edit")
	[ -z "${EDIT_FAIL:-}" ] || [ -e "$s/edit-failed" ] || { touch "$s/edit-failed"; exit 1; }
	jq --argjson n "$3" --arg l "$(arg --remove-label "$@")" 'map(if .number == $n then .labels -= [$l] else . end)' "$s/issues" >"$s/i.new" && mv "$s/i.new" "$s/issues" ;;
"pr create")
	b=$(arg --head "$@")
	cat >"$s/pr-${b//\//_}"
	echo "$by" >"$s/pr-${b//\//_}.by"
	printf '%s\n%s\n' "$b" "$(git remote get-url origin)" >"$s/pr-${b//\//_}.where"
	arg --title "$@" >"$s/pr-${b//\//_}.title"
	[ -z "${CREATE_LOST:-}" ] || exit 1
	echo "https://example.test/pr/${b//\//_}" ;;
"pr ready")
	[ -z "${DRAFT_FAIL:-}" ] || exit 1
	if [ "${4:-}" = --undo ]; then touch "$s/pr-${3##*/}.draft"; else rm -f "$s/pr-${3##*/}.draft"; fi ;;
"pr edit")
	cat >"$s/pr-${3##*/}"
	arg --title "$@" >"$s/pr-${3##*/}.title" ;;
"pr comment")
	[ -f "$s/comments" ] || echo '[]' >"$s/comments"
	jq --arg n "${3##*/}" --arg by "$by" --rawfile b /dev/stdin '. + [{issue: $n, body: $b, user: {login: $by}}]' "$s/comments" >"$s/c.new" && mv "$s/c.new" "$s/comments" ;;
"pr view")
	k=$s/pr-${3##*/}
	[ -f "$s/reviews" ] || echo '[]' >"$s/reviews"
	{ read -r b; read -r o; } <"$k.where"
	[ -e "$k.merged" ] && st=MERGED || st=OPEN
	[ -e "$k.draft" ] && dr=true || dr=false
	jq --arg st "$st" --arg base "$(cat "$k.base" 2>/dev/null || echo main)" --argjson dr "$dr" --arg h "$(git -C "$o" rev-parse "$b" 2>/dev/null)" --arg b "$b" --rawfile body "$k" --arg t "$(cat "$k.title" 2>/dev/null)" \
		'{state: $st, number: 1, baseRefName: $base, isDraft: $dr, headRefOid: $h, headRefName: $b, title: $t, body: $body, reviews: map({id: .node_id, state, commit: {oid: .commit_id}, author: {login: .user.login}, authorAssociation: .author_association})}' "$s/reviews" |
		if q=$(arg --jq "$@") && [ -n "$q" ]; then jq -r "$q"; else cat; fi ;;
api*)
	[ -f "$s/reviews" ] || echo '[]' >"$s/reviews"
	if [ "$2" = -X ] && [ "$3" = PUT ]; then # a pull request's merge, found by its head
		req=$(cat) h=$(jq -r .sha <<<"$req")
		echo "$h" >>"$s/merge-requests"
		[ -z "${MERGE_HOLD:-}" ] || until [ -e "$MERGE_HOLD" ]; do sleep 0.1; done
		if [ -n "${BEFORE_MERGE:-}" ] && [ ! -e "$s/before-merge" ]; then touch "$s/before-merge"; bash -c "$BEFORE_MERGE" >/dev/null 2>&1; fi
		k=
		for w in "$s"/pr-*.where; do
			{ read -r b; read -r o; } <"$w"
			[ "$(git -C "$o" rev-parse "$b" 2>/dev/null)" != "$h" ] || k=${w%.where}
		done
		[ -n "$k" ] || { echo "gh: Head branch was modified. Review and try the merge again. (HTTP 409)" >&2; exit 1; }
		git -C "$o" merge-base --is-ancestor main "$h" || { echo "gh: Head branch is out of date. Review and try the merge again. (HTTP 405)" >&2; exit 1; }
		if [ -n "${REQUIRE_APPROVAL:-}" ] && ! jq -e --arg h "$h" 'any(.[]?; .state == "APPROVED" and .commit_id == $h)' "$s/reviews" >/dev/null 2>&1; then
			echo "gh: At least 1 approving review is required by reviewers with write access. (HTTP 405)" >&2
			exit 1
		fi
		if [ -n "${CI_LATE:-}" ] && [ ! -e "$s/late" ]; then
			touch "$s/late" && echo "$CI_LATE success" >>"$s/ci"
			echo "gh: Required status check \"$CI_LATE\" is expected. (HTTP 405)" >&2
			exit 1
		fi
		c=$(git -C "$o" commit-tree "$h^{tree}" -p main -m "$(jq -r .commit_title <<<"$req")" -m "$(jq -r .commit_message <<<"$req")")
		git -C "$o" update-ref refs/heads/main "$c"
		touch "$k.merged" && echo "$by" >"$k.merged-by"
		echo '{"merged": true}' | jq -r "$(arg --jq "$@")"
		exit 0
	fi
	if [ "$2" = -i ] && [ "$3" = user ]; then # the token's scopes, from scopes
		printf 'HTTP/2.0 200 OK\nX-Oauth-Scopes: %s\n\n{}\n' "$(cat "$s/scopes" 2>/dev/null || echo repo)"
		exit 0
	fi
	case $2 in
	*/issues/*/comments)
		[ -f "$s/comments" ] || echo '[]' >"$s/comments"
		n=${2%/comments} n=${n##*/}
		jq --arg n "$n" '[.[] | select((.issue | tostring) == $n)]' "$s/comments" | jq -r "$(arg --jq "$@")" ;;
	*/issues/[0-9]*)
		read -r st why who <"$s/issue-${2##*/}.state"
		jq -n --arg st "$st" --arg why "${why:-}" --arg who "${who:-}" '{state: $st, state_reason: (if $why == "" then null else $why end), closed_by: (if $who == "" then null else {login: $who} end)}' | jq -r "$(arg --jq "$@")" ;;
	*/reviews/*/comments)
		id=${2%/comments} id=${id##*/}
		jq --argjson id "$id" '[.[] | select(.id == $id)][0].comments // []' "$s/reviews" | jq -r "$(arg --jq "$@")" ;;
	*/reviews)
		if [ "${3:-}" = --input ]; then
			jq --arg by "$by" --slurpfile r /dev/stdin '. + [$r[0] + {id: (length + 1), state: "COMMENTED", user: {login: $by}}]' "$s/reviews" >"$s/reviews.new" && mv "$s/reviews.new" "$s/reviews"
		else
			jq -r "$(arg --jq "$@")" "$s/reviews"
		fi ;;
	*/statuses/*)
		echo "${2##*/} $(printf '%s\n' "$@" | sed -n 's/^state=//p') $by" >>"$s/statuses"
		echo "${2##*/} $(printf '%s\n' "$@" | sed -n 's/^description=//p')" >>"$s/descriptions" ;;
	*/commits/*/check-runs)
		if [ -n "${DURING_CHECKS:-}" ] && [ ! -e "$s/during-checks" ]; then touch "$s/during-checks"; bash -c "$DURING_CHECKS" >/dev/null 2>&1; fi
		perl -MTime::HiRes=time -e 'printf "%.3f\n", time' >>"$s/check-reads"
		[ -z "${CHECKS_SLEEP:-}" ] || sleep "$CHECKS_SLEEP"
		{ [ ! -f "$s/ci" ] || cat "$s/ci"; } | jq -Rn '{check_runs: [inputs | split(" ") | select(length == 2) |
			{name: .[0], status: (if .[1] == "pending" then "in_progress" else "completed" end), conclusion: (if .[1] == "pending" then null else .[1] end), html_url: ("https://example.test/checks/" + .[0])}]}' |
			jq -r "$(arg --jq "$@")" ;;
	*/commits/*/statuses) # each status on the commit, newest first, with its creator
		h=${2%/statuses} h=${h##*/}
		{ [ ! -f "$s/statuses" ] || grep "^$h " "$s/statuses" || true; } | jq -Rn '[inputs | split(" ") | {context: "tend/review", state: .[1], creator: {login: .[2]}}] | reverse' |
			jq -r "$(arg --jq "$@")" ;;
	*/commits/*/status)
		h=${2%/status} h=${h##*/}
		{ [ ! -f "$s/statuses" ] || grep "^$h " "$s/statuses" | tail -1 || true; } | jq -Rn '{statuses: [inputs | split(" ") | {context: "tend/review", state: .[1], target_url: "https://example.test/pr"}]}' |
			jq -r "$(arg --jq "$@")" ;;
	esac ;;
esac
